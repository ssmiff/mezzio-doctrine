{
    "name": "ssmiff/mezzio-doctrine",
    "description": "Doctrine DBAL, ORM and Migrations for Mezzio with named connections selectable on every console command with --conn.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "mezzio",
        "doctrine",
        "dbal",
        "orm",
        "migrations",
        "laminas"
    ],
    "homepage": "https://github.com/ssmiff/mezzio-doctrine",
    "authors": [
        {
            "name": "Scott Smith",
            "email": "scott@ssmiff.uk"
        }
    ],
    "support": {
        "issues": "https://github.com/ssmiff/mezzio-doctrine/issues",
        "source": "https://github.com/ssmiff/mezzio-doctrine"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ssmiff/mezzio-container-helpers"
        }
    ],
    "require": {
        "php": "~8.5.0",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^4.0",
        "laminas/laminas-cli": "^1.10",
        "laminas/laminas-servicemanager": "^4.5",
        "psr/cache": "^3.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/log": "^3.0",
        "ssmiff/mezzio-container-helpers": "^0.1",
        "symfony/cache": "^7.2",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^11.5",
        "psalm/plugin-phpunit": "^0.19.5",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/filesystem": "^7.2 || ^8.0",
        "vimeo/psalm": "^6.13"
    },
    "autoload": {
        "psr-4": {
            "Ssmiff\\MezzioDoctrine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ssmiff\\MezzioDoctrine\\Test\\": "test/"
        }
    },
    "extra": {
        "laminas": {
            "config-provider": "Ssmiff\\MezzioDoctrine\\ConfigProvider"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test"
        ],
        "static-analysis": "psalm --no-cache --stats",
        "test": "phpunit --colors=always",
        "cs-check": [
            "php-cs-fixer fix --dry-run --diff",
            "phpcs"
        ],
        "cs-fix": "php-cs-fixer fix"
    }
}
